# Token fine-grained do GitHub com permissão "Contents: Read and write" SOMENTE no repositório de dados.
GITHUB_TOKEN=
# Repositório PRIVADO onde os JSON ficam (ex.: seu-usuario/linguagens-do-amor-data)
GITHUB_REPO=
GITHUB_BRANCH=main
# Texto aleatório longo para assinar os tokens de login (ex.: node -e "console.log(crypto.randomBytes(32).toString('hex'))")
AUTH_SECRET=
